# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
tests/e2e/.auth/

# next.js
/.next/
/out/
public/workbox-*.js
public/workbox-*.js.map
public/sw.js
public/sw.js.map
public/fallback-*.js
public/worker-*.js

# Sentry
.sentryclirc

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.npm-cache/

# env files (can opt-in for committing if needed)
.env* # envs (NO commitear secretos)
.env.local
.env.*.local
.env

# PERMITIR el template sin valores
!.env.example


# vercel
.vercel

# fly.io — local helpers that may contain plaintext secrets after editing
.fly-secrets.sh
.fly-secrets.local.sh

# typescript
*.tsbuildinfo
next-env.d.ts

# Base44 export (solo lectura local, NO versionar)
reference/base44_export/

# Operational reports (runtime smoke/SLO)
docs/reports/*.json
docs/reports/*.log
!docs/reports/.gitkeep

# Large archives (no upload)
reference/*.zip
*.zip


.env*.local

# Local-only sandbox deploy artifacts: the sandbox proxy intercepts TLS so
# the Dockerfile.cron's curl step fails. Local deploys pre-download
# supercronic + temporarily swap Dockerfile.cron for a COPY-based variant.
# These files exist only during a manual deploy and never belong in CI.
supercronic.bin
Dockerfile.cron.local
Dockerfile.cron.bak
Dockerfile.cron.original
