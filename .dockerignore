# Build artefacts — most are excluded EXCEPT what the pre-built strategy needs.
# We build locally (`npm run build`) and ship the standalone output as-is, so
# .next/standalone and .next/static must be available to the Docker context.
.next/cache
.next/diagnostics
.next/dev
.next/trace
.next/types
.next/server
out
dist
build
coverage
.turbo
.swc

# Dependencies (rebuilt inside container)
node_modules

# Tests / dev artefacts not needed at runtime
playwright-report
test-results
tests/.auth
*.tsbuildinfo

# Local secrets — never bake into image
.env
.env.*
!.env.example

# Sibling projects in this repo that are NOT deployed with the web app.
# They have their own Fly.io apps (coinarb-50x, polyarb-*) or local runtimes.
coinarb
polyarb
bots
lattice-desktop
GoldRangeBasketR

# Git / editor / OS
.git
.gitignore
.gitattributes
.gitmodules
.github
.vscode
.idea
.cursor
.claude
.DS_Store
Thumbs.db

# Docs / config not needed by runtime
*.md
!README.md
docs
scripts
supabase
.env.example
.dockerignore
Dockerfile
Dockerfile.cron
fly.toml
fly.cron.toml
# NOTE: do NOT exclude `crontab` — Dockerfile.cron needs it in the build context.
MIGRATION-RUNBOOK.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
