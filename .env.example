# Supabase Configuration
# Obtén estos valores de: Supabase Dashboard → Project Settings → API

# URL pública de tu proyecto Supabase (visible en cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave anónima de Supabase (visible en cliente, solo lectura)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
# hCaptcha site key (public, safe for client)
# SUPABASE_SERVICE_ROLE_KEY=... (si necesitas en edge functions)

# Server-only Supabase Key (for cron endpoints)
# Only set this if you need to access Supabase from server-side cron endpoints
SUPABASE_SERVICE_ROLE_KEY=

# App Configuration
NEXT_PUBLIC_APP_NAME=AlphaLog
NODE_ENV=development

# Domain Configuration (IONOS)
# Primary domain for the application
NEXT_PUBLIC_APP_URL=https://alphalog.io
ALPHALOG_WEB_URL=https://alphalog.io

# Security Configuration
# Canonical domain for CSP and security headers (auto-detected from NEXT_PUBLIC_APP_URL if not set)
NEXT_PUBLIC_CANONICAL_HOST=alphalog.io

# Web Push Configuration (para notificaciones push)
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# E2E Testing Configuration (Playwright)
# Set these for local E2E testing
E2E_EMAIL=test@alphalog.local
E2E_PASSWORD=Test@123456
PLAYWRIGHT_BASE_URL=http://localhost:3000
# Cron Job Configuration (Scheduled Treasury tasks)
# Secret token for securing cron endpoints (prevent unauthorized calls)
# Generate a strong random string: openssl rand -base64 32
CRON_SECRET=

# ============================================
# QStash (Upstash) Configuration - Update 07
# ============================================
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional: override base URL if using a non-default QStash endpoint
QSTASH_BASE_URL=

# Alphalog Web URL (used by Supabase Edge Functions)
# This is the publicly accessible URL of your deployment
# Local dev: http://localhost:3000
# Staging: https://staging.alphalog.com
# Production: https://alphalog.com
ALPHALOG_WEB_URL=

# Canonical domain (apex)
NEXT_PUBLIC_CANONICAL_HOST=

# Data Encryption (server-side)
# 32-byte key in base64 for AES-256-GCM
DATA_ENCRYPTION_KEY=

# AlphaShield UI (System) - Internal use only
# Set to "true" to enable /dashboard/logs/system in the UI
NEXT_PUBLIC_ENABLE_SYSTEM_LOGS=false

# Accounts Architect Bot (AAB)
# Set to "false" to hide /dashboard/tradehub/accounts/aab
NEXT_PUBLIC_ENABLE_AAB=true

# Business Module Configuration
# Runway threshold in months for low runway alerts (default: 3)
RUNWAY_THRESHOLD_MONTHS=3

# ============================================
# Secure Email Configuration (Sprint 13)
# ============================================
# Postmark Configuration (https://postmarkapp.com)
# Server token for sending emails via Postmark API
POSTMARK_SERVER_TOKEN=

# Inbound webhook authentication. Postmark uses HTTP Basic Auth in the URL
# (NOT HMAC signature), so configure the webhook URL in Postmark as:
#   https://USER:PASSWORD@alphalog.io/api/inbound/email
# Both must be set or all inbound emails are rejected (fail-closed).
POSTMARK_INBOUND_WEBHOOK_USER=
POSTMARK_INBOUND_WEBHOOK_PASSWORD=

# Legacy HMAC secret (kept for backward compat — currently unused after the
# Basic Auth switch). Safe to leave empty going forward.
POSTMARK_INBOUND_WEBHOOK_SECRET=

# Domain for receiving emails (e.g., @alphalog.io)
# Mailbox aliases will be <user>@<domain>
SECURE_MAIL_DOMAIN=alphalog.io

# Maximum attachment size in bytes (default: 10MB)
SECURE_MAIL_MAX_EMAIL_ATTACHMENT_BYTES=10485760
# Client-exposed secure mail config (used in UI)
NEXT_PUBLIC_SECURE_MAIL_DOMAIN=alphalog.io
NEXT_PUBLIC_SECURE_MAIL_MAX_EMAIL_ATTACHMENT_BYTES=10485760

# OpenAI API Key
OPENAI_API_KEY=

# MT5 Webhook Secret
MT5_WEBHOOK_SECRET=

# Ops alerting token (internal API /api/ops/bot-slo-alert)
OPS_ALERT_TOKEN=
# Owner user_id for persisting bot daily verification events in bot_events
BOT_OPS_USER_ID=

# API Rate Limit
# Window in seconds and max requests per window
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120

# Export Hardening Configuration
# Maximum file size for exports (bytes, default 50MB)
# EXPORT_MAX_FILE_SIZE=52428800
# Maximum records per export (default 100,000)
# EXPORT_MAX_RECORDS=100000
# Rate limits: exports per minute and per hour per user
# EXPORT_RATE_LIMIT_MINUTE=3
# EXPORT_RATE_LIMIT_HOUR=20

# Edge Functions Configuration
SUPABASE_FUNCTIONS_URL=

# Bot Control (Edge Functions)
# Optional: URL to AlphaLog push notify endpoint
ALPHALOG_PUSH_NOTIFY_URL=
# Optional: token for internal push notify calls
ALPHALOG_PUSH_NOTIFY_TOKEN=

# ============================================
# Sentry (Error monitoring + Performance tracing)
# ============================================
# When empty, the SDK initializes as a no-op — no errors thrown, no events
# sent. Set these once you have a Sentry project (https://sentry.io).
#
# Runtime DSNs — copy from Sentry Project → Settings → Client Keys (DSN).
# Both env vars hold the same value; the public one is exposed to the browser.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Build-time (Vercel CI only). Required for source-map upload so stack traces
# show real file/line numbers. Without these the build still passes but errors
# appear minified.
#   - SENTRY_ORG / SENTRY_PROJECT: slugs from your Sentry URL
#   - SENTRY_AUTH_TOKEN: Settings → Auth Tokens → New (scope: project:releases)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
