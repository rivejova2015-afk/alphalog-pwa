{
  "name": "alphalog-pwa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "perf:bundle-budget": "node scripts/perf/check-bundle-budget.js",
    "security:check-rls": "node scripts/security/check-rls-coverage.js",
    "audit:sprints": "node scripts/sprint-audit.js",
    "audit:tables": "node scripts/audit-db-tables.mjs",
    "audit:tables:offline": "node scripts/audit-db-tables.mjs --offline",
    "smoke:algo-pipeline": "node scripts/smoke/algo-pipeline.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/generate-storage-state.js && playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:auth:remote": "playwright test tests/e2e/auth.spec.ts --project=chromium --workers=1",
    "test:e2e:smoke:remote": "playwright test tests/e2e/api-health.spec.ts tests/e2e/auth.spec.ts tests/e2e/smoke.spec.ts tests/e2e/navigation.spec.ts tests/e2e/mobile-layout-fit.spec.ts --project=chromium --workers=1",
    "pilot:bot-runtime": "node scripts/bot-runtime-pilot.js",
    "ops:bot-control-plane-smoke": "node scripts/bot-control-plane-smoke.js",
    "ops:bot-control-plane-window": "node scripts/bot-control-plane-window.js",
    "ops:bot-slo-monitor": "node scripts/bot-slo-monitor.js",
    "ops:bot-slo-window": "node scripts/bot-control-plane-window.js --interval-min 15 --runs 96 --failFastOn s1",
    "ops:bot-auto-recovery": "node scripts/bot-auto-recovery.js --actionOn S1 --cooldownMin 15",
    "ops:bot-daily-summary": "node scripts/bot-ops-daily-summary.js --timezone America/Puerto_Rico --keepDays 14",
    "ops:bot-daily-verify": "node scripts/bot-daily-verification.js",
    "ops:tasks:register": "powershell -ExecutionPolicy Bypass -File scripts/ops/register-bot-ops-tasks.ps1",
    "ops:tasks:unregister": "powershell -ExecutionPolicy Bypass -File scripts/ops/unregister-bot-ops-tasks.ps1",
    "pilot:bot:agent": "node scripts/bot-runtime-agent.js",
    "pilot:bot:finalize": "node scripts/bot-runtime-finalizer.js",
    "ops:cleanup-temp-secrets": "node scripts/security/cleanup-temp-secrets.js",
    "auth:link-password": "node scripts/link-password-to-google-user.js",
    "verify:all": "npm run build && npm run test:e2e && npm run audit:sprints"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^3.4.5",
    "@sentry/nextjs": "^10.53.1",
    "@serwist/next": "^9.5.11",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@types/three": "^0.184.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.562.0",
    "next": "^16.2.6",
    "openpgp": "^6.3.0",
    "postmark": "^4.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "serwist": "^9.5.11",
    "sonner": "^2.0.7",
    "three": "^0.184.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
