{
  "name": "coinarb-crypto-engine",
  "version": "1.0.0",
  "description": "Coinarb — Spot-only SMC trading bot for Coinbase Advanced (BTC-USD/ETH-USD/SOL-USD) with latency arbitrage vs Binance and capital phase compounding",
  "private": true,
  "type": "module",
  "main": "dist/core/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/core/index.js",
    "dev": "tsx watch src/core/index.ts",
    "boot:products": "tsx scripts/boot-products.ts",
    "test:cdp-auth": "tsx scripts/test-cdp-auth.ts",
    "backtest": "tsx scripts/backtest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "dotenv": "^16.4.5",
    "jose": "^5.9.6",
    "undici": "^8.1.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^4.1.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
