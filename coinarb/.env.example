# =============================================================================
# coinarb-50x — Coinbase ultra-aggressive trading engine
# =============================================================================

# -----------------------------------------------------------------------------
# Agent identity (Supabase polyarb_agents row, distinguished by agent_id)
# -----------------------------------------------------------------------------
COINARB_AGENT_ID=coinarb-50x
COINARB_USER_ID=

# -----------------------------------------------------------------------------
# Coinbase Advanced Trade — Spot (US), CDP API key with JWT ES256
# Source: https://portal.cdp.coinbase.com/access/api
# -----------------------------------------------------------------------------
COINBASE_CDP_KEY_NAME=organizations/{org_id}/apiKeys/{key_id}
COINBASE_CDP_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----

# -----------------------------------------------------------------------------
# Coinbase International Exchange — Perps, HMAC-SHA256 + passphrase
# Source: https://international.coinbase.com/portfolios → API
# -----------------------------------------------------------------------------
COINBASE_INTX_API_KEY=
COINBASE_INTX_SECRET=
COINBASE_INTX_PASSPHRASE=
COINBASE_INTX_PORTFOLIO_ID=

# -----------------------------------------------------------------------------
# Supabase (shared with AlphaLog PWA + PolyArb)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://jgkvnnlodwdtjsmmzwry.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATA_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# AlphaLog push notifications
# -----------------------------------------------------------------------------
ALPHALOG_PUSH_NOTIFY_URL=https://www.alphalog.io/api/push/notify-user
ALPHALOG_PUSH_NOTIFY_TOKEN=

# -----------------------------------------------------------------------------
# 50x strategy parameters (see src/strategies/fifty-x/config-50x.ts)
# -----------------------------------------------------------------------------
COINARB_50X_PAPER_MODE=1                          # 1 = simulated fills, 0 = real orders
COINARB_50X_TICK_MS=250
COINARB_50X_TOTAL_CAPITAL_USD=100
COINARB_50X_SPOT_ALLOCATION_PCT=0.60
COINARB_50X_PERP_ALLOCATION_PCT=0.40
COINARB_50X_MAX_KELLY_FRACTION=0.25
COINARB_50X_MAX_LEVERAGE=5.0
COINARB_50X_MAX_AGGREGATE_EXPOSURE_PCT=1.0
COINARB_50X_DAILY_TRADE_CAP=7
COINARB_50X_LOSS_COOLDOWN_MS=2400000              # 40 min
COINARB_50X_DRAWDOWN_BREAKER_PCT=0.25
COINARB_50X_DRAWDOWN_BREAKER_COOLDOWN_MS=86400000 # 24 h
COINARB_50X_FUNDING_ADVERSE_THRESHOLD=0.0005      # 0.05% / h
COINARB_50X_POST_ONLY=1
COINARB_50X_WS_STALE_TIMEOUT_MS=60000

# Tier knobs (defaults match polyarb-50x)
COINARB_50X_SCALP_KELLY_MULT=0.10
COINARB_50X_CASCADE_TRIGGER=0.02
COINARB_50X_CASCADE_DECAY=0.75
COINARB_50X_CASCADE_MAX_LVLS=4
COINARB_50X_ENTER_MIN_GAP=0.020
COINARB_50X_ENTER_MIN_CONF=0.70
COINARB_50X_ENTER_MIN_LAYERS=4
COINARB_50X_SCALP_MIN_GAP=0.015
COINARB_50X_SCALP_MIN_CONF=0.60
COINARB_50X_SCALP_MIN_LAYERS=3
COINARB_50X_MAX_OPEN_POSITIONS=2
COINARB_50X_ENTRY_WINDOW_MS=60000
