# DB cleanup (Sprint L) — purges api_rate_limits (>2h), app_logs (>30d),
# progress_events (>60d), app_update_events (>30d), cme_signals terminal (>90d).
# api_rate_limits hourly window means this needs to run frequently — every 3h.
0    */3  *  *  *   curl --fail --max-time 120 -X POST -H "x-cron-secret: $CRON_SECRET" http://alphalog-pwa.internal:3000/api/cron/db/cleanup

