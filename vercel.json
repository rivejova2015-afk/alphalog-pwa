{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/terminal/reports/refresh",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/terminal/news-fetch",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/terminal/price-fetch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/terminal/calendar-fetch",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/ops/cron/bot-heartbeat-monitor",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/ops/cron/polyarb-heartbeat",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ops/cron/coinarb-heartbeat",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ops/cron/polyarb-daily-report",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/backtest/paper-bridge",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/backtest/daemon",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/bars/ingest",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/algorithms/paper-review",
      "schedule": "45 5 * * *"
    }
  ]
}
